{
  "name": "proofit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts apps/eve/tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/console/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p apps/eve/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "scenarios": "node scripts/scenarios.ts",
    "preflight": "node scripts/preflight.ts",
    "migrate": "node scripts/migrate.ts",
    "seed": "node scripts/seed.ts",
    "dev": "node --watch apps/backend/main.ts",
    "start": "node apps/backend/main.ts",
    "start:standalone": "node --env-file=.env.nvidia apps/standalone/main.ts",
    "standalone:probe": "node --env-file=.env.nvidia scripts/standalone-probe.ts",
    "start:executor": "node apps/executor/main.ts",
    "stripe:probe": "node scripts/stripe-probe.ts",
    "nvidia:probe": "node scripts/nvidia-probe.ts",
    "dev:console": "vite --config apps/console/vite.config.ts",
    "build": "vite build --config apps/console/vite.config.ts",
    "browser:install": "node scripts/browser-tests.ts install",
    "test:browser": "node scripts/browser-tests.ts",
    "nvidia:investigation:probe": "node scripts/nvidia-investigation-probe.ts",
    "start:worker": "node apps/worker/main.ts",
    "dev:eve": "node --env-file=.env.nvidia scripts/eve-service.ts",
    "eve:probe": "node --env-file=.env.nvidia apps/eve/probe.ts",
    "test:development": "node scripts/development-cases.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.34",
    "eve": "0.83.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "eve": {
      "undici": "8.12.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
