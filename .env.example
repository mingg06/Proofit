# Names only. Configure securely; never commit credentials.
# Backend process only; optional overrides have local defaults. No session signing key: opaque sessions are stored server-side.
DATABASE_PATH=
APP_ORIGIN=
PORT=
# Investigator process only; no Stripe execution key
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
ZETARIS_BASE_URL=
ZETARIS_TOKEN=
ZETARIS_STRUCTURED_SOURCE_ID=
ZETARIS_POLICY_SOURCE_ID=
METERLESS_BASE_URL=
METERLESS_TOKEN=
# Executor process only; test environment only
STRIPE_TEST_SECRET_KEY=
EXECUTOR_SERVICE_SECRET=

# Optional isolated reservation service loopback port (default 4001)
EXECUTOR_PORT=
