# Names only. Configure securely; never commit credentials.
# Backend process only; optional overrides have local defaults. No session signing key: opaque sessions are stored server-side.
DATABASE_PATH=
APP_ORIGIN=
PORT=
# Investigator process only; no Stripe execution key
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
# Isolated eve process only; local dev:eve generates its own gitignored service secret.
EVE_SERVICE_SECRET=
ZETARIS_BASE_URL=
ZETARIS_TOKEN=
ZETARIS_STRUCTURED_SOURCE_ID=
ZETARIS_POLICY_SOURCE_ID=
# Optional future hosted-memory configuration; unused by the local H-MEM working subset.
METERLESS_BASE_URL=
METERLESS_TOKEN=
# Executor process only; test environment only
STRIPE_TEST_SECRET_KEY=
EXECUTOR_SERVICE_SECRET=

# Optional isolated reservation service loopback port (default 4001)
EXECUTOR_PORT=

# Enable queueing only after an operator-installed runtime and access gates are verified.
PROOFIT_AUTOMATIC_REVIEW=
# Trusted local module exporting createRuntime; never a client/model-selected path.
PROOFIT_RUNTIME_MODULE=
# Optional backend container binding; default stays loopback. Non-loopback requires HTTPS APP_ORIGIN.
BIND_HOST=
